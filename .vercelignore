# OS site deploys from its own Vercel project
ventrify-os/

# NOTE: ventrify-assess/ is intentionally NOT ignored here.
# Its own Vercel project (verdict.ventrify.io) builds with "Include files
# outside root directory" and applies this repo-root .vercelignore — listing
# it here strips the files from that project's build → empty 404 deploy.

# Dev / scratch
node_modules/
temporary screenshots/
_*.mjs
screenshot.mjs
.DS_Store
**/.DS_Store

# Unrelated archives
Test site/
Workflow/
workflow new/
decks/
brand_assets/
