rules_version = '2';

// Ventrify OS — Firestore security rules.
// Replaces test-mode (world-open). The engagement repo's Admin SDK bypasses
// these entirely (service account), so the bridge keeps working; these rules
// govern the CLIENT apps (Workspace operators + Studio founders).
//
// Model:
//   • Operators are listed in organisations/{orgId}.operatorEmails (managed by
//     the Admin SDK / console — clients cannot self-escalate).
//   • Founders are matched by the email on their engagement (founderEmail).
//   • Investability snapshots are written ONLY by the Admin SDK bridge.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userEmail() { return request.auth.token.email; }

    function orgData(orgId) {
      return get(/databases/$(database)/documents/organisations/$(orgId)).data;
    }
    function isOperatorOf(orgId) {
      return signedIn()
        && exists(/databases/$(database)/documents/organisations/$(orgId))
        && 'operatorEmails' in orgData(orgId)
        && userEmail() in orgData(orgId).operatorEmails;
    }
    function engData(engId) {
      return get(/databases/$(database)/documents/engagements/$(engId)).data;
    }

    // Organisations — branding + the operator allowlist. Public read: the org
    // name/logo/colour are rendered on the PUBLIC login pages (before sign-in),
    // so the doc must be readable unauthenticated. operatorEmails is low-
    // sensitivity (knowing an email grants nothing — access needs the magic
    // link); it's written only by the Admin SDK / console (never by clients).
    match /organisations/{orgId} {
      allow read: if true;
      allow write: if false;
    }

    // Platform config (super-admin allowlist). Readable by any signed-in user
    // (to resolve super-admin status client-side); written only by Admin SDK.
    match /app/{document} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Engagements — a founder sees only their own; operators see their org's.
    match /engagements/{engId} {
      allow read: if signedIn()
        && (userEmail() == resource.data.founderEmail || isOperatorOf(resource.data.orgId));
      // Update is open to founder/operator EXCEPT the server-managed integrity fields:
      //   • assessmentSignoff — the operator endorsement that rides into the shared memo;
      //   • shareLink        — the public share-link pointer.
      // These are set ONLY by the Admin SDK (/api/memo), which bypasses these rules.
      // Blocking them here stops a founder from forging a senior-partner sign-off, a
      // share link, or an operator decision (confirm/decline) via a hand-crafted SDK write.
      //   • assessmentGaps   — the assessment's own record of WHAT IT LOOKED FOR AND COULD NOT FIND, and
      //     therefore docked the venture for. It is written by the runner (publish.js publishGaps). A client
      //     must not be able to edit or delete our declared misses: the gap list is the honest ledger the
      //     whole file-evidence loop hangs off, and an operator who could quietly drop a gap could quietly
      //     drop the evidence that the score was suppressed by our own failure.
      allow update: if signedIn()
        && (userEmail() == resource.data.founderEmail || isOperatorOf(resource.data.orgId))
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['assessmentSignoff', 'shareLink', 'assessmentDecision', 'assessmentGaps']);
      // Creation is intentionally NOT allowed from the client. It goes through
      // /api/create-engagement (Admin SDK), which enforces the org's licence
      // capabilities + quota server-side — so the one-off / licence limits
      // can't be bypassed by a hand-crafted write. Operators still read/update/
      // delete their org's engagements.
      allow create: if false;
      allow delete: if isOperatorOf(resource.data.orgId);

      // Investability trajectory — readable by founder/operator; written only
      // by the engagement repo's Admin SDK bridge.
      match /investabilitySnapshots/{snapId} {
        allow read: if signedIn()
          && (userEmail() == engData(engId).founderEmail || isOperatorOf(engData(engId).orgId));
        allow write: if false;
      }

      // Data-room L3 hub content — readable by founder/operator; written only by
      // the engagement repo's Admin SDK bridge.
      match /hubDocs/{docId} {
        allow read: if signedIn()
          && (userEmail() == engData(engId).founderEmail || isOperatorOf(engData(engId).orgId));
        allow write: if false;
      }

      // ── THE EVIDENCE LEDGER — operator-filed pointers to evidence we could not find ──
      //
      // The operator's only powers are: name a gap WE declared, hand us a pointer, and trigger a cold
      // re-run. These rules are what make that true in the database rather than merely true in the UI.
      //
      //  • OPERATOR-ONLY. Not the founder: these are OUR research misses, and the venture must never be
      //    able to file evidence about itself through this channel.
      //  • APPEND-ONLY (no update, no delete). This is the single rule that stops the feature being a dial
      //    with extra steps: an operator CANNOT bin a record whose evidence went against the venture. Once
      //    filed, it is scored, and the outcome is on the record whichever way it fell.
      //  • HE FILES A POINTER; THE SYSTEM WRITES WHAT IT FOUND. The create is rejected if it carries any
      //    field the FETCHER or the SCORER owns — contentSha, httpStatus, finalUrl, bytes, capturedFile,
      //    signalDelta, compositeDelta, rescoredIn. He cannot pre-declare what the page says, nor what it
      //    did to the score. The runner (Admin SDK) bypasses these rules and stamps them afterwards.
      //  • status must be exactly 'filed' — 'captured' is the runner's word, not his.
      match /operatorEvidence/{recId} {
        allow read: if signedIn() && isOperatorOf(engData(engId).orgId);
        allow create: if signedIn()
          && isOperatorOf(engData(engId).orgId)
          && request.resource.data.orgId == engData(engId).orgId
          && request.resource.data.status == 'filed'
          && request.resource.data.gapId is string
          && !request.resource.data.keys().hasAny([
               'contentSha', 'httpStatus', 'finalUrl', 'contentType', 'bytes', 'capturedFile',
               'fetchedAt', 'fetchError', 'extraction', 'text',
               'signalDelta', 'compositeDelta', 'rescoredIn', 'rescoredAt', 'batchRecords'
             ]);
        allow update, delete: if false;
      }
    }

    // Provocation cards — operators have full access to their org's cards.
    // Founders may read + respond ONLY to RELEASED cards on their own engagement
    // (status != 'draft'): operator drafts are invisible to the founder even via
    // a direct query, not just hidden in the UI.
    match /cards/{cardId} {
      allow read, update: if signedIn()
        && (isOperatorOf(engData(resource.data.engagementId).orgId)
            || (userEmail() == engData(resource.data.engagementId).founderEmail
                && resource.data.status != 'draft'));
      allow create: if isOperatorOf(request.resource.data.orgId);
      allow delete: if isOperatorOf(engData(resource.data.engagementId).orgId);
    }
  }
}
