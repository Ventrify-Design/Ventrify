{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/m/:token",
      "destination": "/api/memo?t=:token"
    }
  ],
  "functions": {
    "api/sweep-stuck-runs.js": {
      "maxDuration": 60
    },
    "api/memo.js": {
      "maxDuration": 60
    },
    "api/intake-run.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/intake-run",
      "schedule": "*/5 * * * *"
    }
  ]
}
